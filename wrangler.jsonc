{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoul-house-forum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "seoul-house-forum"
    }
  ],
  // 로컬 개발(`pnpm dev`, `--local`)은 id와 무관하게 .wrangler/state 의 SQLite를 사용한다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seoul-housing-forum-db",
      "database_id": "9470f947-7972-4880-8ced-5e19c4b8269f",
      "migrations_dir": "migrations"
    }
  ],
  // 파일 저장소는 Supabase Storage를 쓴다(R2는 Worker와 같은 계정에서만 바인딩 가능).
  // 같은 계정에 R2를 만들면 여기에 r2_buckets 바인딩(FILES)을 추가하는 것만으로 다시 전환된다.
  // 공개 값만 vars에 둔다. 비밀 값은 `wrangler secret put`(운영) / .dev.vars(로컬)로 주입한다.
  //   TURNSTILE_SECRET_KEY, GA4_CLIENT_EMAIL, GA4_PRIVATE_KEY
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE-l72sUc7ZmiaxA",
    "GA4_PROPERTY_ID": "555495161",
    "SUPABASE_URL": "https://gryevfsrzaodwukkozin.supabase.co",
    "SUPABASE_STORAGE_BUCKET": "forum-files"
  },
  /*
   * 검색엔진 소유 확인 코드와 정식 도메인은 빌드 시점에 HTML에 박히므로 Worker의 vars가 아니라
   * 빌드 환경변수로 넣는다. 로컬은 .env.local, 배포는 빌드를 돌리는 쉘의 환경변수를 쓴다.
   *   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION, NEXT_PUBLIC_NAVER_SITE_VERIFICATION
   * 기본값은 src/constants/site.ts 에 있다.
   */
  "observability": {
    "enabled": true
  },
  /*
   * 환경 분리.
   * - 기본(위 설정) = 운영. `pnpm deploy`
   * - preview = 배포 전 확인용. `pnpm exec opennextjs-cloudflare deploy -- --env preview`
   * 바인딩과 vars는 환경 간에 상속되지 않으므로 preview에도 그대로 다시 적어야 한다.
   * 시크릿도 환경별로 따로 넣는다: `wrangler secret put <이름> --env preview`
   */
  "env": {
    "preview": {
      "name": "seoul-house-forum-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "seoul-house-forum-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "seoul-house-forum-db-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE-l72sUc7ZmiaxA",
        "GA4_PROPERTY_ID": "555495161",
        "SUPABASE_URL": "https://gryevfsrzaodwukkozin.supabase.co",
        "SUPABASE_STORAGE_BUCKET": "forum-files"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
