{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoul-house-forum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "seoul-house-forum"
    }
  ],
  // database_id는 `wrangler d1 create seoul-house-forum-db` 결과로 교체한다.
  // 로컬 개발(`pnpm dev`, `--local`)은 id와 무관하게 .wrangler/state 의 SQLite를 사용한다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seoul-house-forum-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "seoul-house-forum-files"
    }
  ],
  // 공개 값만 vars에 둔다. 비밀 값은 `wrangler secret put`(운영) / .dev.vars(로컬)로 주입한다.
  //   TURNSTILE_SECRET_KEY, GA4_CLIENT_EMAIL, GA4_PRIVATE_KEY
  // TURNSTILE_SITE_KEY 기본값은 Cloudflare 공식 테스트 키(항상 통과)이므로 배포 전 실제 키로 교체한다.
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "GA4_PROPERTY_ID": ""
  },
  "observability": {
    "enabled": true
  }
}
